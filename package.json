{
  "name": "chrome-bfsg-check",
  "description": "Chrome extension that checks the current page for accessibility issues relevant to the German BFSG (EN 301 549 / WCAG 2.1 AA) and gives local performance hints. Everything runs locally in the browser.",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "BlueBranch GmbH <lb@bluebranch.de> (https://www.bluebranch.de/)",
  "homepage": "https://www.bluebranch.de/",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "postinstall": "wxt prepare",
    "icons": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/outfit": "5.3.0",
    "axe-core": "4.13.0",
    "vue": "3.5.43"
  },
  "devDependencies": {
    "@wxt-dev/module-vue": "1.0.3",
    "happy-dom": "20.14.5",
    "typescript": "5.9.3",
    "vitest": "5.0.2",
    "vue-tsc": "3.3.11",
    "wxt": "0.21.4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/BlueBranch-GmbH/chrome-bfsg-check.git"
  },
  "engines": {
    "node": ">=20"
  },
  "bugs": {
    "url": "https://github.com/BlueBranch-GmbH/chrome-bfsg-check/issues"
  }
}
